# The public address people use (needed for GitHub sign-in and cookies).
PUBLIC_URL=https://inference.flisk.si
# GitHub OAuth app: callback URL is PUBLIC_URL/auth/callback. Never commit the real values.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only these GitHub logins may sign in (comma-separated). Leave empty to let any GitHub user in.
ALLOWED_LOGINS=odykyi
